{
  "extends": "@ai-first-ts/config/tsconfig.base.json",
  "references": [{ "path": "../../packages/api" }],
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ai-first-ts/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
