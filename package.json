{
  "name": "ai-first-ts",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.7",
      "ai": "^7.0.93",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.19.0",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter='!desktop' && turbo run build -F desktop",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:desktop": "turbo run dev:hmr -F desktop --",
    "build:desktop": "turbo run build:stable -F desktop --",
    "build:desktop:canary": "turbo run build:canary -F desktop --",
    "dev:tui": "turbo run dev -F tui --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @ai-first-ts/db --",
    "db:studio": "turbo run db:studio -F @ai-first-ts/db --",
    "db:generate": "turbo run db:generate -F @ai-first-ts/db --",
    "db:migrate": "turbo run db:migrate -F @ai-first-ts/db --",
    "db:local": "turbo run db:local -F @ai-first-ts/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-first-ts/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "catalog:",
    "husky": "latest",
    "lefthook": "latest",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
